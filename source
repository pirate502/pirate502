// ---------- 7. Checkout / Return ----------
export function CheckoutReturn() {
  const [memberId, setMemberId] = useState('');
  const [scanned, setScanned] = useState([]);

  function addScan(code) {
    setScanned(prev => [...prev, code]);
  }

  return (
    <div className="p-6">
      <h2 className="text-xl font-bold">Mượn / Trả nhanh</h2>

      <div className="grid grid-cols-2 gap-6 mt-4">
        <div className="bg-white rounded shadow p-4">
          <label className="text-sm text-gray-600">Quét mã thành viên</label>
          <input value={memberId} onChange={e => setMemberId(e.target.value)} className="w-full border rounded px-3 py-2" placeholder="Scan or enter member ID" />

          <div className="mt-4">
            <h4 className="font-semibold">Thông tin thành viên (demo)</h4>
            <div className="text-sm text-gray-600">{memberId ? `Member: ${memberId}` : 'Chưa có thành viên'}</div>
          </div>
        </div>

        <div className="bg-white rounded shadow p-4">
          <label className="text-sm text-gray-600">Quét mã sách</label>
          <div className="flex gap-2 mt-2">
            <input id="scan" className="w-full border rounded px-3 py-2" placeholder="Scan barcode..." onKeyDown={e => { if (e.key === 'Enter') { addScan(e.target.value); e.target.value = ''; } }} />
            <SecondaryButton onClick={() => addScan('manual-scan-' + (scanned.length + 1))}>Add</SecondaryButton>
          </div>

          <div className="mt-4">
            <h4 className="font-semibold">Giỏ mượn</h4>
            <ul className="mt-2 space-y-2 text-sm">
              {scanned.map((s, i) => <li key={i} className="flex justify-between items-center"><span>{s}</span><button className="text-red-600">Xóa</button></li>)}
            </ul>
          </div>

          <div className="mt-4">
            <PrimaryButton>Xác nhận Mượn</PrimaryButton>
          </div>
        </div>
      </div>
    </div>
  );
}

// ---------- Preview App (default export) ----------
export default function App() {
  const [screen, setScreen] = useState('dashboard');
  const [selectedBook, setSelectedBook] = useState(null);
  const [selectedMember, setSelectedMember] = useState(null);

  function renderMain() {
    switch (screen) {
      case 'dashboard': return <Dashboard />;
      case 'books': return <BooksList onView={(b) => { setSelectedBook(b); setScreen('bookDetail'); }} />;
      case 'bookDetail': return <BookDetail book={selectedBook} onBack={() => setScreen('books')} />;
      case 'addBook': return <AddEditBook onSave={(data) => { alert('Saved (mock): ' + JSON.stringify(data)); setScreen('books'); }} />;
      case 'members': return <MembersList onView={(m) => { setSelectedMember(m); setScreen('memberDetail'); }} />;
      case 'memberDetail': return <MemberDetail member={selectedMember} onBack={() => setScreen('members')} />;
      case 'checkout': return <CheckoutReturn />;
      default: return <Dashboard />;
    }
  }

  return (
    <div className="min-h-screen bg-gray-50 text-gray-800">
      <div className="max-w-7xl mx-auto">
        <div className="flex gap-6 items-center p-4 border-b bg-white">
          <div className="text-lg font-bold">Library Mockups</div>
          <nav className="flex gap-2 ml-6">
            <button onClick={() => setScreen('dashboard')} className={`px-3 py-1 rounded ${screen === 'dashboard' ? 'bg-indigo-600 text-white' : 'text-gray-700 hover:bg-gray-100'}`}>Dashboard</button>
            <button onClick={() => setScreen('books')} className={`px-3 py-1 rounded ${screen === 'books' ? 'bg-indigo-600 text-white' : 'text-gray-700 hover:bg-gray-100'}`}>Kho sách</button>
            <button onClick={() => setScreen('addBook')} className={`px-3 py-1 rounded ${screen === 'addBook' ? 'bg-indigo-600 text-white' : 'text-gray-700 hover:bg-gray-100'}`}>Thêm sách</button>
            <button onClick={() => setScreen('members')} className={`px-3 py-1 rounded ${screen === 'members' ? 'bg-indigo-600 text-white' : 'text-gray-700 hover:bg-gray-100'}`}>Thành viên</button>
            <button onClick={() => setScreen('checkout')} className={`px-3 py-1 rounded ${screen === 'checkout' ? 'bg-indigo-600 text-white' : 'text-gray-700 hover:bg-gray-100'}`}>Mượn/Trả</button>
          </nav>
        </div>

        <main className="bg-gray-50">{renderMain()}</main>
      </div>
    </div>
  );
}
