// ---------- 4. Add/Edit Book (Form) ----------
export function AddEditBook({ initial = {}, onSave }) {
  const [form, setForm] = useState({
    title: initial.title || '',
    isbn: initial.isbn || '',
    authors: initial.authors ? initial.authors.join(', ') : '',
    category: initial.category || '',
    year: initial.year || '',
    copies: initial.copies || 1,
    location: initial.location || ''
  });

  function handleChange(e) {
    const { name, value } = e.target;
    setForm(prev => ({ ...prev, [name]: value }));
  }

  return (
    <div className="p-6">
      <h2 className="text-xl font-bold">{initial.id ? 'Sửa sách' : 'Thêm sách'}</h2>
      <div className="mt-4 grid grid-cols-2 gap-4">
        <div>
          <label className="text-sm text-gray-600">Tiêu đề</label>
          <input name="title" value={form.title} onChange={handleChange} className="w-full border rounded px-3 py-2" />
        </div>
        <div>
          <label className="text-sm text-gray-600">ISBN</label>
          <input name="isbn" value={form.isbn} onChange={handleChange} className="w-full border rounded px-3 py-2" />
        </div>
        <div>
          <label className="text-sm text-gray-600">Tác giả (phân cách bằng ,)</label>
          <input name="authors" value={form.authors} onChange={handleChange} className="w-full border rounded px-3 py-2" />
        </div>
        <div>
          <label className="text-sm text-gray-600">Thể loại</label>
          <input name="category" value={form.category} onChange={handleChange} className="w-full border rounded px-3 py-2" />
        </div>
        <div>
          <label className="text-sm text-gray-600">Năm</label>
          <input name="year" value={form.year} onChange={handleChange} className="w-full border rounded px-3 py-2" />
        </div>
        <div>
          <label className="text-sm text-gray-600">Số bản (copies)</label>
          <input type="number" name="copies" value={form.copies} onChange={handleChange} className="w-full border rounded px-3 py-2" />
        </div>
        <div className="col-span-2">
          <label className="text-sm text-gray-600">Vị trí / Kệ</label>
          <input name="location" value={form.location} onChange={handleChange} className="w-full border rounded px-3 py-2" />
        </div>
      </div>

      <div className="mt-4 flex gap-2">
        <PrimaryButton onClick={() => onSave && onSave(form)}>Lưu</PrimaryButton>
        <SecondaryButton>Hủy</SecondaryButton>
      </div>
    </div>
  );
}

