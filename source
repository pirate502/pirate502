      </div>

      <div className="mt-4 flex items-center justify-between text-sm text-gray-600">
        <div>{Object.values(selected).filter(Boolean).length} mục được chọn</div>
        <div>Pagination (demo)</div>
      </div>
    </div>
  );
}

