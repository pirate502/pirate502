    <script>
        // Sample data
        let students = [
            { id: 'SV001', name: 'Nguyễn Văn Thành', gender: 'Nam', class: 'CNTT-K20A', faculty: 'CNTT', course: '2020-2024', gpa: 8.5, status: 'active' },
            { id: 'SV002', name: 'Trần Thị Hương Anh', gender: 'Nữ', class: 'CNTT-K20B', faculty: 'CNTT', course: '2020-2024', gpa: 7.2, status: 'warning' },
            { id: 'SV003', name: 'Lê Minh Tuấn', gender: 'Nam', class: 'KT-K20A', faculty: 'KT', course: '2020-2024', gpa: 8.8, status: 'active' },
            { id: 'SV004', name: 'Phạm Thu Hương', gender: 'Nữ', class: 'CNTT-K20A', faculty: 'CNTT', course: '2020-2024', gpa: 9.0, status: 'active' }
        ];

        // Navigation
        function showPage(pageName) {
            const pages = ['dashboard', 'students', 'classes', 'subjects', 'grades', 'statistics', 'settings'];
            pages.forEach(page => {
                const element = document.getElementById(page + 'Page');
                if (element) {
                    element.style.display = 'none';
                }
            });

            const targetPage = document.getElementById(pageName + 'Page');
            if (targetPage) {
                targetPage.style.display = 'block';
            }

            document.querySelectorAll('.menu-item').forEach(item => {
                item.classList.remove('active');
            });
            event.target.classList.add('active');
        }

        // Modal functions
        function openAddStudentModal() {
            document.getElementById('studentModal').classList.add('active');
        }

        function openCreateClassModal() {
            document.getElementById('classModal').classList.add('active');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }

        function viewStudentDetail(studentId) {
            document.getElementById('studentDetailModal').classList.add('active');
        }

        function editStudent(studentId) {
            closeModal('studentDetailModal');
            openAddStudentModal();
            showNotification('Chế độ chỉnh sửa sinh viên ' + studentId, 'success');
        }

        function deleteStudent(studentId) {
            if (confirm('Bạn có chắc chắn muốn xóa sinh viên này?')) {
                showNotification('Đã xóa sinh viên ' + studentId, 'success');
            }
        }

        function saveStudent() {
            const name = document.getElementById('studentName').value;
            if (!name) {
                showNotification('Vui lòng nhập đầy đủ thông tin bắt buộc!', 'error');
                return;
            }
            showNotification('Đã lưu thông tin sinh viên thành công!', 'success');
            closeModal('studentModal');
        }

        function saveClass() {
            showNotification('Đã tạo lớp học thành công!', 'success');
            closeModal('classModal');
        }

        // Tab switching
        function switchTab(event, tabId) {
            const tabContent = event.target.closest('.modal-content') || document;
            
            tabContent.querySelectorAll('.tab').forEach(tab => {
                tab.classList.remove('active');
            });
            event.target.classList.add('active');

            tabContent.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
            });
            tabContent.querySelector('#' + tabId).classList.add('active');
        }

        // Notification
        function showNotification(message, type) {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = 'notification ' + type + ' active';
            
            setTimeout(() => {
                notification.classList.remove('active');
            }, 3000);
        }

        // Search functionality
        document.getElementById('globalSearch').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            console.log('Đang tìm kiếm:', searchTerm);
        });

        // Filter functionality
        document.getElementById('facultyFilter')?.addEventListener('change', function(e) {
            console.log('Lọc theo khoa:', e.target.value);
        });

        document.getElementById('statusFilter')?.addEventListener('change', function(e) {
            console.log('Lọc theo trạng thái:', e.target.value);
        });

        // Close modals when clicking outside
        window.addEventListener('click', function(e) {
            if (e.target.classList.contains('modal')) {
                e.target.classList.remove('active');
            }
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 's') {
                e.preventDefault();
                console.log('Ctrl+S: Lưu nhanh');
            }
            if (e.key === 'n' && !e.target.matches('input, textarea')) {
                openAddStudentModal();
            }
            if (e.key === 'f' && !e.target.matches('input, textarea')) {
                e.preventDefault();
                document.getElementById('globalSearch').focus();
            }
        });

        // Auto-save draft
        let autoSaveTimer;
        document.querySelectorAll('.form-input').forEach(input => {
            input.addEventListener('input', function() {
                clearTimeout(autoSaveTimer);
                autoSaveTimer = setTimeout(() => {
                    console.log('Tự động lưu bản nháp...');
                }, 20000);
            });
        });

        // Initialize on load
        window.addEventListener('load', function() {
            console.log('Hệ thống quản lý sinh viên đã sẵn sàng!');
        });
    </script>
